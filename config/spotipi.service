[Unit]
Description=spotipi LED matrix display daemon
After=network-online.target
Wants=network-online.target

[Service]
# ExecStart is appended by install_pi.sh (it injects the install path,
# Spotify username and token path). Runs as root for GPIO access.
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
